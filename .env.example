# Twitch app credentials — create an app at https://dev.twitch.tv/console (Category: Analytics Tool)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Game to discover (Twitch category name)
CLIPCORE_GAME=Grand Theft Auto VI

# Where recordings, clips and the database live
# CLIPCORE_DATA_DIR=./data

# Clips rendered per hour of stream (the rest stay as unrendered candidates)
CLIPCORE_CLIPS_PER_HOUR=1.5

# Posting window, local time (24h)
CLIPCORE_POST_START=11
CLIPCORE_POST_END=23

# Captions (requires: pip install -e ".[captions]")  tiny | base | small | medium
CLIPCORE_WHISPER_MODEL=small
CLIPCORE_FONT=Inter
