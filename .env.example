# Easiest: leave this file alone and use the Admin page instead.
# Values saved in Admin override anything here.

# Twitch app (optional): enables viewer-clip ranking for Twitch links
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional AI clip judge (recommended): ranks moments and writes hook titles
ANTHROPIC_API_KEY=

# Blank = open sign-up. Set a code to make sign-up invite-only.
CLIPCORE_INVITE_CODE=

CLIPCORE_MAX_PARALLEL_JOBS=2
CLIPCORE_JOBS_PER_USER=2
CLIPCORE_RETENTION_DAYS=7
CLIPCORE_MAX_VOD_HOURS=14

# Caption model: tiny | base | small | medium (bigger = more accurate, slower)
CLIPCORE_WHISPER_MODEL=small
CLIPCORE_FONT=Inter
# CLIPCORE_DATA_DIR=./data
